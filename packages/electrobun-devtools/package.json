{
  "name": "electrobun-devtools",
  "version": "0.2.4",
  "description": "Dev-mode instrumentation lib for Electrobun apps. Drop into your `src/bun/index.ts` to expose runtime state to the electrobun-plugin MCP server (Claude Code). Read more at https://github.com/arijit-gogoi/electrobun-plugin",
  "license": "MIT",
  "author": "arijit-gogoi",
  "repository": "https://github.com/arijit-gogoi/electrobun-plugin",
  "homepage": "https://github.com/arijit-gogoi/electrobun-plugin/tree/main/packages/electrobun-devtools",
  "keywords": [
    "electrobun",
    "devtools",
    "mcp",
    "claude",
    "bun",
    "desktop",
    "instrumentation"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "peerDependencies": {
    "electrobun": ">=1.18.0-beta"
  },
  "peerDependenciesMeta": {
    "electrobun": {
      "optional": false
    }
  }
}